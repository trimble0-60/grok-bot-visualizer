  "edges": [
    { "from": "start", "to": "find", "label": "a search", "kind": "always" },
    { "from": "find", "to": "brief", "label": "strong leads", "kind": "only-when" },
    { "from": "brief", "to": "surface", "label": "sourced brief", "kind": "always" },
    { "from": "surface", "to": "approve", "label": "decision request", "kind": "always" },
    { "from": "approve", "to": "held", "label": "not yet", "kind": "only-when" },
    { "from": "approve", "to": "draft", "label": "approved", "kind": "only-when" },
    { "from": "draft", "to": "send", "label": "draft note", "kind": "always" },
    { "from": "send", "to": "draft", "label": "changes", "kind": "asks-and-waits" }
  ]
